[gd_scene load_steps=2 format=3 uid="uid://main_menu_001"]

[ext_resource type="Script" path="res://main_menu.gd" id="1_mm"]

; Layout:
;   MainMenu (Node2D, script)
;   └─ CanvasLayer
;      └─ Root (Control, full screen)      ← all UI anchors to this
;         ├─ BG (ColorRect, full screen)   ← background, recolours on flip
;         ├─ BGLabel (Label, full screen)  ← faint giant "FLIP"
;         └─ Center (CenterContainer)      ← keeps the panel centred at any window size
;            └─ Panel (PanelContainer)
;               └─ VBox …
[node name="MainMenu" type="Node2D"]
script = ExtResource("1_mm")

[node name="CanvasLayer" type="CanvasLayer" parent="."]

[node name="Root" type="Control" parent="CanvasLayer"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="BG" type="ColorRect" parent="CanvasLayer/Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.95, 0.95, 0.95, 1)

[node name="BGLabel" type="Label" parent="CanvasLayer/Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
modulate = Color(0, 0, 0, 0.07)
theme_override_font_sizes/font_size = 200
text = "FLIP"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Center" type="CenterContainer" parent="CanvasLayer/Root"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="CanvasLayer/Root/Center"]
layout_mode = 2
custom_minimum_size = Vector2(360, 320)

[node name="VBox" type="VBoxContainer" parent="CanvasLayer/Root/Center/Panel"]
layout_mode = 2
size_flags_vertical = 4
theme_override_constants/separation = 18

[node name="Title" type="Label" parent="CanvasLayer/Root/Center/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 46
text = "FLIP"
horizontal_alignment = 1

[node name="Tagline" type="Label" parent="CanvasLayer/Root/Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)
theme_override_font_sizes/font_size = 14
text = "Zögere. Dann entscheide."
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="CanvasLayer/Root/Center/Panel/VBox"]
layout_mode = 2
custom_minimum_size = Vector2(0, 10)

[node name="StartButton" type="Button" parent="CanvasLayer/Root/Center/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Spielen"

[node name="ExitButton" type="Button" parent="CanvasLayer/Root/Center/Panel/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Beenden"

[connection signal="pressed" from="CanvasLayer/Root/Center/Panel/VBox/StartButton" to="." method="_on_start_pressed"]
[connection signal="pressed" from="CanvasLayer/Root/Center/Panel/VBox/ExitButton"  to="." method="_on_exit_pressed"]
