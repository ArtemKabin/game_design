[gd_scene load_steps=12 format=3 uid="uid://flip_level0_001"]

[ext_resource type="Script" path="res://flip_level_0.gd"    id="1_l0"]
[ext_resource type="PackedScene" path="res://flip_player.tscn" id="2_fp"]
[ext_resource type="PackedScene" path="res://flip_sphere.tscn" id="3_fs"]
[ext_resource type="PackedScene" path="res://flip_hud.tscn"    id="4_hud"]
[ext_resource type="PackedScene" path="res://game_over_ui.tscn" id="5_go"]
[ext_resource type="Script" path="res://platform_draw.gd"   id="6_pd"]

; ── Collision Shapes ──────────────────────────────────────────────────────────

; Ground / main platforms (thick)
[sub_resource type="RectangleShape2D" id="RS_ground"]
size = Vector2(400, 32)

[sub_resource type="RectangleShape2D" id="RS_plat_mid"]
size = Vector2(240, 24)

[sub_resource type="RectangleShape2D" id="RS_plat_goal"]
size = Vector2(280, 24)

; Goal trigger
[sub_resource type="RectangleShape2D" id="RS_goal"]
size = Vector2(60, 80)

; Air sensor over pit 1 (detects when player is mid-air above gap)
[sub_resource type="RectangleShape2D" id="RS_pit1_air"]
size = Vector2(200, 160)

; Pit death zones (kill on fall into void)
[sub_resource type="RectangleShape2D" id="RS_void"]
size = Vector2(2400, 40)

; ── ROOT ──────────────────────────────────────────────────────────────────────
[node name="FlipLevel0" type="Node2D"]
script = ExtResource("1_l0")

; ── PLAYER ───────────────────────────────────────────────────────────────────
[node name="FlipPlayer" parent="." instance=ExtResource("2_fp")]
position = Vector2(-640, -64)

[node name="Camera2D" type="Camera2D" parent="FlipPlayer"]
position_smoothing_enabled = true
position_smoothing_speed = 6.0
limit_left = -900
limit_top = -400
limit_right = 1200
limit_bottom = 300

; ── PLATFORM GROUP ──────────────────────────────────────────────────────────
[node name="Platforms" type="Node2D" parent="."]

; ── START PLATFORM (left, wide) ───────────────────────────────────────────
[node name="StartPlatform" type="StaticBody2D" parent="Platforms"]
position = Vector2(-640, -32)
collision_layer = 1

[node name="CollisionShape2D" type="CollisionShape2D" parent="Platforms/StartPlatform"]
shape = SubResource("RS_ground")

[node name="PlatformDraw" type="Node2D" parent="Platforms/StartPlatform"]
script = ExtResource("6_pd")
width = 400.0
height = 32.0

; ── MID PLATFORM (between pit 1 and pit 2) ───────────────────────────────
[node name="MidPlatform" type="StaticBody2D" parent="Platforms"]
position = Vector2(160, -32)
collision_layer = 1

[node name="CollisionShape2D" type="CollisionShape2D" parent="Platforms/MidPlatform"]
shape = SubResource("RS_plat_mid")

[node name="PlatformDraw" type="Node2D" parent="Platforms/MidPlatform"]
script = ExtResource("6_pd")
width = 240.0
height = 24.0

; ── GOAL PLATFORM (right) ────────────────────────────────────────────────
[node name="GoalPlatform" type="StaticBody2D" parent="Platforms"]
position = Vector2(860, -160)
collision_layer = 1

[node name="CollisionShape2D" type="CollisionShape2D" parent="Platforms/GoalPlatform"]
shape = SubResource("RS_plat_goal")

[node name="PlatformDraw" type="Node2D" parent="Platforms/GoalPlatform"]
script = ExtResource("6_pd")
width = 280.0
height = 24.0

; ── GROUND (visual floor behind everything, very wide) ───────────────────
[node name="GroundLine" type="Node2D" parent="."]
position = Vector2(100, -16)

; ── VOID KILL ZONE ───────────────────────────────────────────────────────
[node name="VoidKillZone" type="Area2D" parent="."]
position = Vector2(100, 260)
collision_layer = 0
collision_mask = 1

[node name="CollisionShape2D" type="CollisionShape2D" parent="VoidKillZone"]
shape = SubResource("RS_void")

; ── PIT 1 AIR SENSOR ─────────────────────────────────────────────────────
; Hovering trigger over the first gap (between start and mid platform).
; When the player body enters = they stepped off the edge.
[node name="Pit1AirSensor" type="Area2D" parent="."]
position = Vector2(-180, -96)
collision_layer = 0
collision_mask = 1

[node name="CollisionShape2D" type="CollisionShape2D" parent="Pit1AirSensor"]
shape = SubResource("RS_pit1_air")

; ── GOAL AREA ────────────────────────────────────────────────────────────
[node name="GoalArea" type="Area2D" parent="."]
position = Vector2(860, -196)
collision_layer = 0
collision_mask = 1

[node name="CollisionShape2D" type="CollisionShape2D" parent="GoalArea"]
shape = SubResource("RS_goal")

; ── FLIP SPHERE ──────────────────────────────────────────────────────────
; Floats above gap 2 (between mid platform and goal platform).
; In WHITE world = safe (collision layer 2, player can land on it).
; In BLACK world = deadly.
[node name="FlipSphere" parent="." instance=ExtResource("3_fs")]
position = Vector2(560, -140)

; ── GOAL MARKER (simple visual label on the goal platform) ───────────────
[node name="GoalMarker" type="Label" parent="."]
position = Vector2(780, -200)
theme_override_font_sizes/font_size = 22
text = "ZIEL"
modulate = Color(0.5, 0.5, 0.5, 0.7)

; ── CANVAS LAYER (HUD + Game Over) ───────────────────────────────────────
[node name="CanvasLayer" type="CanvasLayer" parent="."]

[node name="FlipHUD" parent="CanvasLayer" instance=ExtResource("4_hud")]

[node name="GameOverUI" parent="CanvasLayer" instance=ExtResource("5_go")]

; ── CONNECTIONS ──────────────────────────────────────────────────────────
[connection signal="body_entered" from="VoidKillZone"              to="."  method="_on_void_kill_zone_body_entered"]
[connection signal="body_entered" from="Platforms/MidPlatform"     to="."  method="_on_mid_platform_body_entered"]
