[gd_scene load_steps=9 format=3 uid="uid://game_001"]

[ext_resource type="Script"      path="res://game.gd"           id="1_game"]
[ext_resource type="PackedScene" path="res://player.tscn"       id="2_player"]
[ext_resource type="PackedScene" path="res://hud.tscn"          id="3_hud"]
[ext_resource type="PackedScene" path="res://game_over_ui.tscn" id="4_go"]
[ext_resource type="Script"      path="res://bg.gd"             id="5_bg"]
[ext_resource type="Shader"      path="res://sight_fog.gdshader" id="6_fogsh"]
[ext_resource type="Script"      path="res://sight_fog.gd"      id="7_fog"]

[sub_resource type="ShaderMaterial" id="SM_fog"]
shader = ExtResource("6_fogsh")
shader_parameter/fog_color = Color(0.95, 0.95, 0.95, 1)
shader_parameter/radius = 520.0
shader_parameter/softness = 120.0
shader_parameter/size = Vector2(4000, 4000)

[node name="Game" type="Node2D"]
script = ExtResource("1_game")

; ── Background layer (renders behind everything) ──────────────────────────────
[node name="BGLayer" type="CanvasLayer" parent="."]
layer = -1

[node name="Background" type="ColorRect" parent="BGLayer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.95, 0.95, 0.95, 1)
script = ExtResource("5_bg")

; ── Player ────────────────────────────────────────────────────────────────────
; Spawn at (200, -20): ground top is at y=0, player half-height=18, so -20 is 2px above ground.
[node name="Player" parent="." instance=ExtResource("2_player")]
position = Vector2(200, -20)

[node name="Camera2D" type="Camera2D" parent="Player"]
position_smoothing_enabled = true
position_smoothing_speed = 7.0
limit_left   = -600
limit_top    = -400
limit_right  = 9999999
limit_bottom = 360
zoom = Vector2(1.1, 1.1)

; ── Chunk container ───────────────────────────────────────────────────────────
[node name="ChunkRoot" type="Node2D" parent="."]

; ── Sight fog ─────────────────────────────────────────────────────────────────
; Child of the player, so it is always centred on them. Hides everything beyond
; the sight radius (sight_fog.gd). z_index 50: above chunks and spheres, below
; safe markers (60). HUD is on a CanvasLayer and stays unaffected.
[node name="SightFog" type="Node2D" parent="Player"]
z_index = 50
script = ExtResource("7_fog")

[node name="Rect" type="ColorRect" parent="Player/SightFog"]
material = SubResource("SM_fog")
offset_left = -2000.0
offset_top = -2000.0
offset_right = 2000.0
offset_bottom = 2000.0
mouse_filter = 2

; ── HUD layer ─────────────────────────────────────────────────────────────────
[node name="CanvasLayer" type="CanvasLayer" parent="."]

[node name="HUD" parent="CanvasLayer" instance=ExtResource("3_hud")]

[node name="GameOverUI" parent="CanvasLayer" instance=ExtResource("4_go")]
